PORT=5005
FRONTEND_ORIGIN=http://localhost:5173
PUBLIC_SITE_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:5005/api
TRUST_PROXY=0

# MongoDB connection string (local development example).
MONGODB_URI=mongodb://127.0.0.1:27017/morning_star

# Configure during the integrations phase; values belong only in a local/server .env.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Stephen Rotich <info@morningstar-ef.org>"
CONTACT_RECIPIENT=s.rotich@morningstar-ef.org

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Paystack secret key is server-only. Use the test secret while developing.
PAYSTACK_SECRET_KEY=

# Single administrator account. Generate a bcrypt hash with `npm run admin:hash`.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# Generate a long random secret (at least 32 bytes) for signed session cookies.
JWT_SECRET=
# Keep `strict` when frontend and API share a site. For cross-site hosting use
# `none` with HTTPS in production, and retain the exact FRONTEND_ORIGIN allowlist.
ADMIN_COOKIE_SAME_SITE=strict
